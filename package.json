{
  "name": "road//zero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-with-lobby.mjs",
    "dev:game": "vite --host 0.0.0.0",
    "multiplayer:server": "node server/index.mjs",
    "multiplayer:serve": "SERVE_DIST=1 node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test": "vitest run src",
    "test:multiplayer": "node --test server/*.test.mjs",
    "gate:multiplayer": "npm run build && node scripts/multiplayer-gate.mjs",
    "gate:race-together": "npm run build && node scripts/multiplayer-race-gate.mjs",
    "gate": "npm run build && node scripts/road-zero-gate.mjs dist receipts/playtests/current"
  },
  "dependencies": {
    "three": "^0.180.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "puppeteer": "^25.11.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
